[Unit]
Description=Switchboard Server
Documentation=https://github.com/raymondottun/go-voice
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=govoice
Group=govoice

# Binary and configuration. The environment file (chmod 600, owned by root) must set
# TOKEN_SECRET, GOVOICE_MANAGEMENT_API_KEY and GOVOICE_DATABASE_DSN, plus the provider
# variables for the providers you use (XAI_API_KEY, GOOGLE_API_KEY,
# GOOGLE_APPLICATION_CREDENTIALS=<path readable by govoice>, MCP_TOKEN_*; see
# docs/providers.md). Provider keys are never stored: rotating one is an edit and a restart.
WorkingDirectory=/opt/govoice
EnvironmentFile=-/etc/govoice/env
Environment=GOVOICE_ROOT=/opt/govoice
Environment=GOVOICE_MODEL_PATH=/opt/govoice/models/silero_vad.onnx
Environment=GOVOICE_ORT_LIB=/opt/govoice/lib/libonnxruntime.so
ExecStart=/opt/govoice/bin/server -config /etc/govoice/production.yaml

# Process lifecycle and graceful shutdown
# SIGTERM drains for drain_timeout. TimeoutStopSec is longer than drain_timeout plus the 5s process margin.
KillSignal=SIGTERM
TimeoutStopSec=60s
Restart=always
RestartSec=5s

# File descriptor and process limits
LimitNOFILE=65536
LimitNPROC=4096
LimitMEMLOCK=infinity

# Hardened security sandbox
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/tmp /var/log/govoice

[Install]
WantedBy=multi-user.target
