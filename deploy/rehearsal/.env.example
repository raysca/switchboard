# Provider keys for the rehearsal (real values spend a little credit; placeholders are enough for a plumbing check).
XAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
# 32+ characters each, different from one another: `openssl rand -hex 32` makes a good value.
TOKEN_SECRET=
GOVOICE_MANAGEMENT_API_KEY=
# The encrypted secret store (seed writes demo MCP tokens here): "k1:" plus the base64 of 32 random
# bytes, for example: echo "k1:$(openssl rand -base64 32)".
SWITCHBOARD_SECRETS_KEY=

# Demo MCP bearer tokens (only when seeding a demo; match the deployed demo MCP service).
DENTAL_MCP_TOKEN=
ATLAS_MCP_TOKEN=
