# Copy to examples/.env (git-ignored) and fill in. A development server (`make dev`)
# loads it at start and detects providers from these variables (the environment
# wins); `make dev` then seeds the "Dev Assistant" flow from what was detected.
# Also read by the e2e suites, tools/livecheck and the standalone Go examples.
# Every variable per provider: server/catalog/data/*.yaml.

# Gemini API key: used for the LLM stage.
GOOGLE_API_KEY=

# Service-account JSON, relative to examples/: needed for speech (streaming
# Speech-to-Text rejects API keys) and used for Text-to-Speech.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json

# Optional: xAI (LLM; STT/TTS in -tags xaispeech builds), also for the xai_pipeline /
# full_xai_pipeline examples.
XAI_API_KEY=

# Optional: the other catalog providers. Uncomment what you have; each is detected
# by its variable alone (server/catalog/data/<provider>.yaml lists the services).
# DEEPGRAM_API_KEY=          # STT
# CARTESIA_API_KEY=          # STT, TTS
# ELEVENLABS_API_KEY=        # STT, TTS
# OPENAI_API_KEY=            # LLM (any OpenAI-compatible server)
# OPENAI_BASE_URL=           # optional; a single token, no spaces, no $VAR
# NVIDIA_API_KEY=            # LLM (hosted NIM); STT/TTS also need the two function ids
# NVIDIA_STT_FUNCTION_ID=
# NVIDIA_TTS_FUNCTION_ID=
# MCP_TOKEN_CRM=             # bearer token for an MCP server created with auth_env=MCP_TOKEN_CRM
# MCP_TOKEN_TEST=test-token  # make dev's test MCP servers (cmd/mcptest); the default is test-token
