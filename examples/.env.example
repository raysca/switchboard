# Copy to examples/.env (git-ignored) and fill in. Read by `make dev` (to seed the
# "Dev Assistant" agent), the e2e suite and the standalone Go examples. The server
# itself never reads these; it uses credentials stored through the admin API.

# Gemini API key: used for the LLM stage.
GOOGLE_API_KEY=

# Service-account JSON, relative to examples/: needed for speech (streaming
# Speech-to-Text rejects API keys) and used for Text-to-Speech.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json

# Optional: xAI, for the xai_pipeline / full_xai_pipeline examples.
XAI_API_KEY=
