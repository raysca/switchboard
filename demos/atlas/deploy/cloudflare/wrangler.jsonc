{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlas-mcp-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "AtlasMCPContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "Dockerfile.mcp",
          "build_context": "../../../.."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP", "class_name": "AtlasMCPContainer" }
    ]
  },
  "exports": {
    "AtlasMCPContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
