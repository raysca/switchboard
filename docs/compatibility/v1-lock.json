{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "govoice-v1-lock",
  "version": "1.0.0",
  "created_at": "2026-09-27T10:00:00Z",
  "description": "Immutable compatibility and production contract lock manifest for Voice Framework V1",
  "toolchain": {
    "go": "1.27.1",
    "node": "22.18.0",
    "npm": "10.9.3",
    "protoc": "36.2"
  },
  "modules": {
    "root": "govoice",
    "core": "govoice/core",
    "providers_google": "govoice/providers/google",
    "providers_xai": "govoice/providers/xai",
    "server": "govoice/server"
  },
  "client_packages": {
    "@pipecat-ai/client-js": {
      "version": "1.13.1",
      "integrity": "sha512-kRzNWBouHrYyoc6iN60RO97kBhB+uAPSXzf3M1tL//w59X8lkPGCL1onM0crh28C64nxP4hJ0+v6Spf5amJKIg==",
      "shasum": "546ff780ffde845fecd960caf73e316206a8c7f6"
    },
    "@pipecat-ai/websocket-transport": {
      "version": "1.7.2",
      "integrity": "sha512-gax+OsOmq8IcXYDXZbWCqNdFkqnDKi/0EaYGqo/gMNX3ZUt9iRkuZjseWyhTnNswnNvajqrzLIL9gUBrcxJw5A==",
      "shasum": "e82c1eb42eacb5cdf0c0f2a8c94e55ce8e00fe7d"
    }
  },
  "protobuf": {
    "source_file": "proto/frames.proto",
    "pipecat_reference_commit": "2967e1c09ad484076089bc88427d305fe8f79fa9",
    "sha256": "adcd346af21673d3385d075c5a662a8407584b4b04f177320609596f4dea5c37",
    "go_module": "google.golang.org/protobuf",
    "go_package": "govoice/core/transport/v1/framespb"
  },
  "rtvi": {
    "protocol_version": "2.1.0",
    "interruption_event": "user-started-speaking",
    "clear_event": "bot-stopped-speaking"
  },
  "audio": {
    "encoding": "PCM16LE",
    "channels": 1,
    "internal_sample_rate": 16000,
    "input_sample_rates": [16000, 24000, 48000],
    "fixed_player_sample_rate": 24000,
    "player_rate_negotiation": false,
    "chunk_duration_ms": 20,
    "sample_alignment_bytes": 2
  },
  "resampler": {
    "implementation": "pure-go stateful streaming linear/polyphase resampler",
    "package": "govoice/core/transport/resample",
    "cgo": false,
    "max_latency_ms": 1,
    "data_races": false
  },
  "vad": {
    "model_file": "third_party/silero_vad.onnx",
    "model_version": "v5",
    "sha256": "1a153a22f4509e292a94e67d6f9b85e8deb25b4988682b7e174c65279d8788e3",
    "onnxruntime_version": "1.29.0",
    "onnxruntime_binding": "github.com/yalue/onnxruntime_go v1.36.0",
    "production_default_executor": "worker-process",
    "development_executor": "in-process-sharded"
  },
  "google_provider": {
    "stt": {
      "endpoint": "speech.googleapis.com",
      "model": "chirp_2",
      "stream_rotation_threshold_seconds": 240,
      "stream_overlap_ms": 500,
      "max_request_bytes": 25600,
      "quota_headroom_multiplier": 2.0
    },
    "tts": {
      "api": "cloud.google.com/go/texttospeech/apiv1",
      "voice": "en-US-Journey-F",
      "encoding": "AudioEncoding_PCM",
      "sample_rate": 24000,
      "max_synthesis_unit_chars": 250
    },
    "llm": {
      "sdk": "google.golang.org/genai",
      "model": "gemini-2.5-flash",
      "auth_modes": ["vertex_adc", "gemini_api_key"]
    }
  },
  "xai_provider": {
    "llm": {
      "endpoint": "https://api.x.ai/v1/responses",
      "model": "grok-2-1212",
      "store_policy": false,
      "auth_scheme": "Bearer",
      "auth_env_var": "XAI_API_KEY"
    }
  },
  "auth_and_admission": {
    "algorithm": "HS256",
    "issuer": "govoice-v1",
    "audience": "govoice-v1-client",
    "query_parameter": "token",
    "max_lifetime_seconds": 300,
    "max_clock_skew_seconds": 5,
    "replay_policy": "atomic_single_use",
    "restart_rule": "reject_iat_older_than_process_start_minus_skew",
    "required_claims": ["iss", "aud", "sub", "iat", "exp", "jti", "kid"]
  },
  "limits_and_timeouts": {
    "max_encoded_message_bytes": 1048576,
    "max_decoded_audio_bytes": 65536,
    "max_buffer_duration_ms": 5000,
    "handshake_timeout_ms": 10000,
    "rtvi_ready_timeout_ms": 5000,
    "read_timeout_ms": 30000,
    "write_timeout_ms": 5000,
    "idle_timeout_ms": 60000,
    "max_session_duration_seconds": 3600,
    "max_pending_handshakes": 256,
    "teardown_timeout_ms": 2000
  },
  "target_platform": {
    "os": "linux",
    "architectures": ["amd64", "arm64"],
    "libc": "glibc-2.31"
  },
  "slos": {
    "handshake_p95_ms": 500,
    "vad_speech_start_delay_p99_ms": 100,
    "transcript_to_first_llm_text_p95_ms": 2500,
    "transcript_to_first_client_audio_p95_ms": 4000,
    "interruption_to_output_flush_ack_p99_ms": 200,
    "old_generation_audio_after_barrier": 0,
    "stale_provider_output_delivered": 0,
    "session_teardown_p99_ms": 2000
  }
}
