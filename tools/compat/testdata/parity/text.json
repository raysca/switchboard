   "intentional_difference": {
    "go": [
     "Steps follow.",
     "1. First item here",
     "2. Second item here"
    ],
    "reason": "go-voice treats newlines and list numbers as boundaries and never splits inside '2.'; Pipecat leaves list-number fragments ('\\n1.') as separate sentences."
   },
   "params": {
