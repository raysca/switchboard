   "id": "closing_quote_stays_with_sentence",
   "intentional_difference": {
    "go": [
     "He said \"stop now!\"",
     "and left quickly.",
     "Done then."
    ],
    "reason": "A terminator that ends a streamed delta splits at once in go-voice (never stall a reply on lookahead), so a closing quote followed by lowercase continuation splits when the delta boundary lands there; the same text in one delta stays whole (core/sentence_test.go)."
   },
   "params": {
    "aggregation": "sentence"
   },
   "pipecat": [
    "He said \"stop now!\" and left quickly.",
